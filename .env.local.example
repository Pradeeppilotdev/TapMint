# Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Treasury (Monad TESTNET only) — never NEXT_PUBLIC_
PRIVATE_KEY=
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NETWORK=testnet

# Reward ratio: score points needed for 1 whole meme token
# Example: 10 → score 47 pays 4 tokens
REWARD_SCORE_PER_TOKEN=10

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server only — bypasses RLS for recording scores + payouts
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public verification key from Privy Dashboard > App settings (PEM, use \n for line breaks).
# Required to verify access tokens before reading private wallet history.
PRIVY_VERIFICATION_KEY=
